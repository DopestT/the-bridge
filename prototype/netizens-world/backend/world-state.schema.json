{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NETIZENS World Client State",
  "type": "object",
  "required": ["version", "citizen", "world"],
  "properties": {
    "version": { "type": "integer", "minimum": 2 },
    "citizen": {
      "type": "object",
      "required": ["id", "name", "initial", "xp", "level", "artifacts", "mode", "form"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "initial": { "type": "string" },
        "xp": { "type": "integer", "minimum": 0 },
        "level": { "type": "integer", "minimum": 1 },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "mode": { "type": "string" },
        "form": { "type": "string", "enum": ["likeness", "stylized", "fictional", "privacy"] }
      }
    },
    "world": {
      "type": "object",
      "required": ["visitedPlaces", "joinedCrews", "followedProjects", "interestedEvents", "plans", "yesNoVotes", "savedRoutes", "timeline"],
      "properties": {
        "visitedPlaces": { "type": "object" },
        "joinedCrews": { "type": "array", "items": { "type": "string" } },
        "followedProjects": { "type": "array", "items": { "type": "string" } },
        "interestedEvents": { "type": "array", "items": { "type": "string" } },
        "plans": { "type": "array", "items": { "type": "object" } },
        "yesNoVotes": { "type": "object" },
        "savedRoutes": { "type": "array", "items": { "type": "object" } },
        "timeline": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
