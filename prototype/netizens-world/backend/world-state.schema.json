{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NETIZENS World Client State V4",
  "type": "object",
  "required": ["version", "citizen", "world"],
  "properties": {
    "version": { "const": 4 },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "citizen": {
      "type": "object",
      "required": ["id", "name", "initial", "xp", "level", "artifacts", "mode", "form"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 40 },
        "initial": { "type": "string", "maxLength": 2 },
        "xp": { "type": "integer", "minimum": 0 },
        "level": { "type": "integer", "minimum": 1 },
        "artifacts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "mode": { "type": "string" },
        "form": { "type": "string", "enum": ["likeness", "stylized", "fictional", "privacy"] },
        "markSeed": { "type": "string" }
      }
    },
    "world": {
      "type": "object",
      "required": [
        "visitedPlaces",
        "plans",
        "yesNoVotes",
        "savedRoutes",
        "perceptionBindings",
        "entities",
        "entityOrder",
        "entityMemberships",
        "entityLinks",
        "discussionItems",
        "notifications",
        "timeline"
      ],
      "properties": {
        "visitedPlaces": { "type": "object" },
        "joinedCrews": { "type": "array", "items": { "type": "string" } },
        "followedProjects": { "type": "array", "items": { "type": "string" } },
        "interestedEvents": { "type": "array", "items": { "type": "string" } },
        "plans": { "type": "array", "items": { "type": "object" } },
        "yesNoVotes": { "type": "object" },
        "savedRoutes": { "type": "array", "items": { "type": "object" } },
        "perceptionBindings": { "type": "array", "items": { "type": "object" } },
        "entities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["id", "placeId", "entityType", "title", "visibility", "status", "createdAt", "updatedAt"],
            "properties": {
              "id": { "type": "string" },
              "placeId": { "type": "string" },
              "entityType": { "type": "string" },
              "parentEntityId": { "type": ["string", "null"] },
              "creatorId": { "type": ["string", "null"] },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "visibility": { "enum": ["public", "members", "invite", "private"] },
              "status": { "type": "string" },
              "metadata": { "type": "object" },
              "createdAt": { "type": "string" },
              "updatedAt": { "type": "string" }
            }
          }
        },
        "entityOrder": { "type": "array", "items": { "type": "string" } },
        "entityMemberships": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["entityId", "citizenId", "role", "status", "provenance", "updatedAt"],
            "properties": {
              "entityId": { "type": "string" },
              "citizenId": { "type": "string" },
              "role": { "type": "string" },
              "status": { "enum": ["invited", "requested", "active", "muted", "left", "removed", "interested", "following"] },
              "provenance": { "enum": ["genuine", "seeded", "demo"] },
              "updatedAt": { "type": "string" }
            }
          }
        },
        "entityLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "fromEntityId", "toEntityId", "linkType", "createdAt"]
          }
        },
        "discussionItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "entityId", "authorId", "parentId", "body", "provenance", "moderationState", "createdAt", "updatedAt"],
            "properties": {
              "id": { "type": "string" },
              "entityId": { "type": "string" },
              "authorId": { "type": ["string", "null"] },
              "parentId": { "type": ["string", "null"] },
              "body": { "type": "string", "maxLength": 5000 },
              "provenance": { "enum": ["genuine", "seeded", "demo"] },
              "moderationState": { "enum": ["visible", "hidden", "removed"] },
              "createdAt": { "type": "string" },
              "updatedAt": { "type": "string" },
              "deletedAt": { "type": ["string", "null"] }
            }
          }
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "citizenId", "type", "payload", "readAt", "createdAt"],
            "properties": {
              "id": { "type": "string" },
              "citizenId": { "type": "string" },
              "type": { "type": "string" },
              "actorId": { "type": ["string", "null"] },
              "entityId": { "type": ["string", "null"] },
              "payload": { "type": "object" },
              "readAt": { "type": ["string", "null"] },
              "createdAt": { "type": "string" }
            }
          }
        },
        "timeline": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}