{
  "name": "netizens-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:storage": "node --experimental-strip-types --test tests/*.test.mjs",
    "performance:check": "node --experimental-strip-types scripts/check-performance-budget.mjs",
    "release:check": "node scripts/validate-release-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "expo": "~57.0.10",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.4",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
